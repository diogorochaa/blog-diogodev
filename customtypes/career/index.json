{
  "id": "career",
  "label": "Career",
  "repeatable": true,
  "status": true,
  "json": {
    "Main": {
      "company": {
        "type": "Text",
        "config": {
          "label": "Company",
          "placeholder": "Empresa"
        }
      },
      "role": {
        "type": "Text",
        "config": {
          "label": "Role",
          "placeholder": "Software Engineer"
        }
      },
      "stage_label": {
        "type": "Text",
        "config": {
          "label": "Stage label (ex.: ROOKIE, FULLSTACK)",
          "placeholder": "ROOKIE"
        }
      },
      "start_date": {
        "type": "Date",
        "config": {
          "label": "Start date"
        }
      },
      "end_date": {
        "type": "Date",
        "config": {
          "label": "End date (vazio = temporada atual)"
        }
      },
      "description": {
        "type": "StructuredText",
        "config": {
          "label": "Description",
          "placeholder": "Contexto da experiência",
          "multi": "paragraph,strong,em,hyperlink"
        }
      },
      "responsibilities": {
        "type": "StructuredText",
        "config": {
          "label": "Responsibilities",
          "placeholder": "Responsabilidades",
          "multi": "paragraph,strong,em,hyperlink,list-item"
        }
      },
      "highlights": {
        "type": "Group",
        "config": {
          "label": "Highlights",
          "repeat": true,
          "fields": {
            "text": {
              "type": "Text",
              "config": {
                "label": "Highlight",
                "placeholder": "Entrega ou conquista relevante"
              }
            }
          }
        }
      },
      "technologies": {
        "type": "Group",
        "config": {
          "label": "Technologies",
          "repeat": true,
          "fields": {
            "name": {
              "type": "Text",
              "config": {
                "label": "Name",
                "placeholder": "Node.js"
              }
            }
          }
        }
      },
      "order": {
        "type": "Number",
        "config": {
          "label": "Order (opcional; padrão é a data de início)",
          "placeholder": "1"
        }
      },
      "active": {
        "type": "Boolean",
        "config": {
          "label": "Active (exibir no site)",
          "default_value": true,
          "placeholder_true": "Sim",
          "placeholder_false": "Não"
        }
      }
    }
  }
}
